# Copy to deploy/rails.env. Loaded into the rails container only (env_file in docker-compose.yml).
# Settings shared with other services (RAILS_ENV, COBRA_DOMAIN, POSTGRES_PASSWORD) belong in
# deploy/.env, not here.

# Required when RAILS_ENV=production. Generate one with `bin/rails secret`.
SECRET_KEY_BASE=

# NetrunnerDB OAuth application.
NRDB_CLIENT=
NRDB_SECRET=

# Always Be Running API token.
ABRAUTH=

RAILS_LOG_LEVEL=info
