# Copy to deploy/.env. Docker Compose reads it to fill in the ${...} values in docker-compose.yml
# and docker-compose.deploy.yml, and refuses to start if any are missing. These values run the
# stack locally; each deployed environment keeps its own deploy/.env.
# Values exported in the shell still take precedence over this file.

# Image tags.
FRONTEND_VERSION=latest
COBRA_SERVER_VERSION=latest

# Public hostname (VIRTUAL_HOST, LETSENCRYPT_HOST and the NRDB OAuth redirect_uri in production).
COBRA_DOMAIN=localhost
# Public origin of the site, passed to the SvelteKit server as ORIGIN.
COBRA_ORIGIN=http://localhost:3000
LETSENCRYPT_EMAIL=webdev-team@nullsignal.games

RAILS_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=cobra
POSTGRES_DB=cobra
