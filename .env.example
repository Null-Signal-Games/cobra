# Copy to .env in the repo root. Used only by the classic top-level docker-compose.yml, which loads
# it into the app and db containers and also reads it to fill in ${...} values. The stack in
# deploy/ does not read this file; see deploy/README.md.
# The values below are for local development.

POSTGRES_PASSWORD=cobra
RAILS_ENV=development

# Production only.
# COBRA_SERVER_VERSION=latest
# COBRA_DOMAIN=
# SECRET_KEY_BASE=
# NRDB_CLIENT=
# NRDB_SECRET=
# ABRAUTH=
# RAILS_LOG_LEVEL=info
