{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "//comments": {
    "dependencies": {
      "@sveltejs/adapter-node": "Pinned to ^5 because adapter-node v6 requires @sveltejs/kit ^3 (this app is on @sveltejs/kit ^2)",
      "apexcharts": "Pinned to ^6 for tournament statistics charts (used in stats/+page.svelte and optimizeDeps)",
      "svelecte": "Pinned to ^5.x for Svelte 5 autocomplete and card selection components"
    },
    "overrides": {
      "cookie": "Pinned to ^0.7.0 to satisfy security updates and SvelteKit cookie handling",
      "@magidoc/plugin-svelte-marked": "Overrides nested svelte peer dependency to use the project's root svelte version ($svelte)"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@magidoc/plugin-svelte-marked": "^7",
    "@svelte-put/qr": "^2.1.3",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.8",
    "apexcharts": "^6.10.0",
    "dompurify": "^3.4.13",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "sass-embedded": "^1.100.0",
    "svelecte": "^5.4.0",
    "svelte": "^5",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  },
  "overrides": {
    "cookie": "^0.7.0",
    "@magidoc/plugin-svelte-marked": {
      "svelte": "$svelte"
    },
    "minimatch": "^11.0.1"
  }
}
