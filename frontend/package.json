{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.0"
	},
	"devDependencies": {
		"@magidoc/plugin-svelte-marked": "^7",
		"@svelte-put/qr": "^2.1.3",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/svelte": "^5.2.8",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"apexcharts": "^8.8.1",
		"dompurify": "^3.4.13",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.95.0",
		"playwright": "^1.65.0",
		"sass-embedded": "^1.108.1",
		"svelecte": "^5.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3"
	},
	"overrides": {
		"@magidoc/plugin-svelte-marked": {
			"svelte": "$svelte"
		},
		"minimatch": "^11.0.1"
	},
	"//comments": {
		"dependencies": {
			"svelecte": "Pinned to ^5.x for Svelte 5 autocomplete and card selection components"
		},
		"overrides": {
			"@magidoc/plugin-svelte-marked": "Overrides nested svelte peer dependency to use the project's root svelte version ($svelte)"
		}
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true
	}
}
