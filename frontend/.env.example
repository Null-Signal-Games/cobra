# Copy to frontend/.env (the devcontainer does this on create). Read by Vite in development only;
# deployed containers get their environment from deploy/docker-compose.yml.

# Base URL the browser uses for API requests: nginx, published to the host on port 3000.
CLIENT_COBRA_API_ENDPOINT=http://localhost:3000/

# Base URL for server-side API requests. bin/dev-stack sets this to nginx inside the container.
# SERVER_COBRA_API_ENDPOINT=
